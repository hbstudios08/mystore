{
  "expo": {
    "name": "Cell Salts & Astrology",
    "slug": "cell-salts-astrology",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "cellsaltsastro",
    "splash": {
      "backgroundColor": "#0B0E23"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.cellsaltsastrology.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Used only as a convenient shortcut to fill in your birth location's latitude/longitude for the Ascendant calculation. You can also enter it manually."
      }
    },
    "android": {
      "package": "com.cellsaltsastrology.app",
      "adaptiveIcon": {
        "backgroundColor": "#0B0E23",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": ["SCHEDULE_EXACT_ALARM", "POST_NOTIFICATIONS", "ACCESS_COARSE_LOCATION", "ACCESS_FINE_LOCATION"]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "color": "#2A3D8F"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Used only as a convenient shortcut to fill in your birth location's latitude/longitude for the Ascendant calculation. You can also enter it manually."
        }
      ]
    ]
  }
}
